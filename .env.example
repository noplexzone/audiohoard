# ============================================================
# Audiohoard — Environment Configuration Example
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# --- Application -------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
SECRET_KEY=
# Session lifetime in seconds (default: 12 hours).
SESSION_TTL_SECONDS=43200
# The documented direct LAN HTTP setup requires false. Set true whenever the
# application is served behind HTTPS so session and CSRF cookies are Secure.
AUTH_COOKIE_SECURE=false

# --- Database ----------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/audiohoard.db

# --- Library Naming ----------------------------------------------
# Template tokens: {album_artist} {year} {album} {disc_track} {title} {ext}
NAMING_TEMPLATE={album_artist}/{album} ({year})/{disc_track} - {title}.{ext}
LIBRARY_ROOT=/music
STAGING_ROOT=/staging/audiohoard

# --- slskd -------------------------------------------------------
SLSKD_URL=
SLSKD_API_KEY=

# --- Prowlarr ----------------------------------------------------
PROWLARR_URL=
PROWLARR_API_KEY=

# --- SABnzbd -----------------------------------------------------
SABNZBD_URL=
SABNZBD_API_KEY=

# --- YouTube (yt-dlp) --------------------------------------------
# No API key required; set cookies file path if needed for age-restricted content
YTDLP_COOKIES_FILE=

# --- TIDAL / tidal-dl --------------------------------------------
# Direct track URLs only. Authenticate once with tidal-dl outside the app.
# Both files must be readable from the container, share a directory, and use
# exactly these filenames. Keep the token file private.
TIDAL_CONFIG_PATH=/app/data/tidal/.tidal-dl.json
TIDAL_SESSION_PATH=/app/data/tidal/.tidal-dl.token.json
TIDAL_QUALITY=HiFi

# --- MusicBrainz -------------------------------------------------
MUSICBRAINZ_APP_NAME=audiohoard
# Optional user-agent override; defaults to the installed Audiohoard package version.
# MUSICBRAINZ_APP_VERSION=0.6.0
MUSICBRAINZ_CONTACT=

# --- Deezer ------------------------------------------------------
# Public API — no key required for metadata lookups
# Set if using a private/partner API endpoint
DEEZER_API_URL=https://api.deezer.com

# --- AcoustID ----------------------------------------------------
# Optional: leave blank to disable cloud fingerprint lookup.
# fpcalc must be available in PATH for local fingerprinting regardless.
ACOUSTID_API_KEY=

# --- Logging -----------------------------------------------------
LOG_LEVEL=INFO
